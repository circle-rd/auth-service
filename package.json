{
    "name": "auth-service",
    "version": "0.1.27",
    "type": "module",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && cd frontend && pnpm build",
        "build:server": "tsc",
        "build:frontend": "cd frontend && pnpm build",
        "start": "node dist/index.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --ui --config tests/e2e/playwright.config.ts",
        "test:e2e:docker": "docker compose -f tests/e2e/docker-compose.yml up --build --wait && playwright test --config tests/e2e/playwright.config.ts"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.6.23",
        "@better-auth/oauth-provider": "^1.6.23",
        "@better-auth/passkey": "^1.6.23",
        "@fastify/cors": "^11.2.0",
        "@fastify/rate-limit": "^10.3.0",
        "@fastify/static": "^9.1.3",
        "better-auth": "^1.6.23",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.2",
        "eta": "^3.5.0",
        "fastify": "^5.8.5",
        "nodemailer": "^8.0.10",
        "postgres": "^3.4.9",
        "stripe": "^22.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@playwright/test": "^1.60.0",
        "@testcontainers/postgresql": "^12.0.1",
        "@types/node": "^22.19.19",
        "@types/nodemailer": "^8.0.0",
        "@types/supertest": "^7.2.0",
        "drizzle-kit": "^0.31.10",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.2.2",
        "testcontainers": "^12.0.1",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.8"
    }
}