{
    "name": "auth-service",
    "version": "0.1.35",
    "description": "Self-hosted OAuth 2.1 / OIDC identity provider with multi-app RBAC, MFA, organizations and billing.",
    "license": "GPL-3.0-or-later",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/circle-rd/auth-service.git"
    },
    "homepage": "https://github.com/circle-rd/auth-service",
    "bugs": {
        "url": "https://github.com/circle-rd/auth-service/issues"
    },
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "scripts": {
        "dev": "NODE_ENV=development tsx watch src/index.ts",
        "build": "tsc && cd frontend && pnpm build",
        "build:server": "tsc",
        "build:frontend": "cd frontend && pnpm build",
        "start": "node dist/index.js",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "test:litellm": "docker run --rm --entrypoint python -v \"$PWD/litellm:/gateway:ro\" -v \"$PWD/tests/litellm:/tests:ro\" -e PYTHONDONTWRITEBYTECODE=1 ${LITELLM_IMAGE:-ghcr.io/berriai/litellm:v1.106.2} -m unittest discover -s /tests -v",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
        "test:e2e:ui": "playwright test --ui --config tests/e2e/playwright.config.ts",
        "test:e2e:docker": "docker compose -f tests/e2e/docker-compose.yml up --build --wait && playwright test --config tests/e2e/playwright.config.ts",
        "llm:setup": "tsx src/scripts/litellm-setup.ts",
        "llm:provision": "tsx src/scripts/litellm-provision.ts",
        "llm:smoke": "tsx src/scripts/litellm-smoke.ts",
        "llm:reconcile": "tsx src/scripts/litellm-reconcile.ts",
        "llm:export": "tsx src/scripts/litellm-export.ts",
        "llm:import": "tsx src/scripts/litellm-import.ts",
        "billing:reconcile": "tsx src/scripts/billing-reconcile.ts",
        "migrate:okta": "tsx src/scripts/migrate.ts okta",
        "migrate:auth0": "tsx src/scripts/migrate.ts auth0",
        "migrate:keycloak": "tsx src/scripts/migrate.ts keycloak",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky || true"
    },
    "lint-staged": {
        "*.ts": [
            "eslint",
            "prettier --write"
        ],
        "*.{json,yml,yaml}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "^1.7.15",
        "@better-auth/oauth-provider": "^1.7.15",
        "@better-auth/passkey": "^1.7.15",
        "@fastify/cors": "^11.3.1",
        "@fastify/helmet": "^13.2.0",
        "@fastify/rate-limit": "^11.2.1",
        "@fastify/static": "^10.1.8",
        "bcryptjs": "^3.0.3",
        "better-auth": "^1.7.15",
        "dotenv": "^18.0.9",
        "drizzle-orm": "^0.45.4",
        "eta": "^4.6.0",
        "fastify": "^5.12.7",
        "ioredis": "^6.0.0",
        "nodemailer": "^10.3.1",
        "pino": "^10.4.0",
        "postgres": "^4.0.0",
        "stripe": "~22.2.3",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@testcontainers/postgresql": "^12.2.1",
        "@types/node": "^22.20.5",
        "@types/supertest": "^7.2.1",
        "@vitest/coverage-v8": "^5.0.5",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "pino-pretty": "^13.2.0",
        "prettier": "^3.9.10",
        "supertest": "^7.3.1",
        "testcontainers": "^12.2.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}