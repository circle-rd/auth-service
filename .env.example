# =====================================================================
# auth-service — environment template. Copy to .env and adjust.
# =====================================================================
# `${VAR}` references in this file are expanded by Docker Compose, so the values
# below build on DOMAIN and PUBLIC_SCHEME. `pnpm dev` and `pnpm llm:*` run on the
# host read this file WITHOUT expansion: for them write the final value (for
# example BETTER_AUTH_URL=http://localhost:3001).

# ── General ─────────────────────────────────────────────────────────────────
# Base domain and scheme of the deployment; the public hosts derive from them
# (auth.${DOMAIN}, and llm.${DOMAIN} for the LiteLLM gateway). For a local stack
# use DOMAIN=localhost, PUBLIC_SCHEME=http and BETTER_AUTH_URL=http://localhost:3001.
DOMAIN=example.com
PUBLIC_SCHEME=https

# Public URL of this service: the OAuth issuer, and the base of every link sent.
BETTER_AUTH_URL=${PUBLIC_SCHEME}://auth.${DOMAIN}

# Public landing page at `/` presenting the service. Leave false to send `/`
# straight to the sign-in. The administration sign-in is at /auth either way.
SHOWCASE=false

# Server
PORT=3001
HOST=0.0.0.0

# CORS — allowed origins (comma-separated, static seed — also auto-populated from app URLs at runtime)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of trusted reverse-proxy hops. Default 0 (secure, no proxy). Set to 1
# when running behind a single reverse proxy so req.ip/rate-limits use the real
# client address instead of the proxy's.
TRUST_PROXY_HOPS=0

# Docker Compose image (docker-compose.yml). `nightly` tracks develop,
# `latest` is the latest tagged release. Override to pin a version.
AUTH_IMAGE=ghcr.io/circle-rd/auth-service:nightly

# Optional services of the compose file are behind profiles: set
# COMPOSE_PROFILES=llm,redis to start them with a plain `docker compose up`.
# COMPOSE_PROFILES=

# NODE_ENV is intentionally not set here: the Compose stack forces
# `production`, and local hot-reload (`pnpm dev`) sets `development` itself.
LOG_LEVEL=
SESSION_DOMAIN=

# ── Secrets and first administrator ─────────────────────────────────────────
BETTER_AUTH_SECRET=        # 32 random bytes: openssl rand -base64 32

# Bootstrap superadmin (auto-created at first startup if absent).
# ADMIN_PASSWORD must be at least 12 characters, and must not be this
# placeholder value (the bootstrap refuses known defaults).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123!

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth_secret
POSTGRES_DB=auth_service
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DATABASE_URL="postgres://auth:auth_secret@localhost:5433/auth_service"

# ── Email ───────────────────────────────────────────────────────────────────
# Email transport (SMTP)
# Required in production whenever any email flow is active
# (REQUIRE_EMAIL_VERIFICATION, MAGIC_LINK_ENABLED, EMAIL_OTP_ENABLED).
# - Port 465: implicit TLS
# - Port 587: STARTTLS upgrade (default)
# - Port 25:  unencrypted (avoid in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="auth-service <no-reply@example.com>"
# Optional Reply-To injected on every outbound email.
MAIL_REPLY_TO=

# Email flow toggles
# REQUIRE_EMAIL_VERIFICATION: when true, BetterAuth refuses to issue a session
# until the user clicks the verification link sent to their email. It is left
# `false` here so the Compose stack boots without SMTP; set it to `true` in
# production and configure SMTP_HOST below.
REQUIRE_EMAIL_VERIFICATION=false
# Opt-in passwordless flows. Both expose new endpoints — enable only after
# SMTP and rate-limits are in place. They sign in existing accounts only: accounts
# are created through an application that allows registration.
MAGIC_LINK_ENABLED=false
EMAIL_OTP_ENABLED=false

# OAuth protected resources (RFC 8707) are managed per application from the
# admin UI (oauth_resource table); there is no env seed for them.

# OAuth social providers (optional — each requires CLIENT_ID + CLIENT_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Phase 5b optional features ──────────────────────────────────────────────
# Reject compromised passwords via the Have I Been Pwned k-anonymity API
# (outbound call on every password write). Off by default.
HAVEIBEENPWNED_ENABLED=false
# Set a signed cookie with the last used sign-in method. Off by default.
LAST_LOGIN_METHOD_ENABLED=false
# OAuth 2.0 Device Authorization Grant (RFC 8628). Requires the device_code
# table migration and enables the /device approval page. Off by default.
DEVICE_AUTHORIZATION_ENABLED=false

# CAPTCHA on credential endpoints. Requires an explicit CAPTCHA_ENABLED=true
# plus provider, secret and site key. WARNING: once enabled, sign-in, sign-up
# and password reset reject requests without an `x-captcha-response` header, so
# do not enable until the client widget ships.
# CAPTCHA_PROVIDER=cloudflare-turnstile | google-recaptcha | hcaptcha | captchafox
# CAPTCHA_ENDPOINTS defaults to sign-up, sign-in and password reset. Values are
# paths relative to /api/auth, e.g. /sign-up/email.
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=
CAPTCHA_ENDPOINTS=

# Stripe (optional — billing integration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=   # From Stripe Dashboard → Webhooks → signing secret
# Online credit top-up bounds in whole euros (customers pay in their own currency,
# converted by Stripe). Without STRIPE_SECRET_KEY, credit is added by an admin.
# WALLET_TOPUP_MIN_EUR=5
# WALLET_TOPUP_MAX_EUR=500
# Price of LLM usage reported by the gateway: provider cost in USD × the rate below
# (explicit, no default for money) × (1 + margin %). These two values are only the
# starting point: a superadmin changes them from the Wallets page, and the saved
# values then take precedence. With neither, the usage endpoint answers 503.
# WALLET_USD_TO_EUR_RATE=0.92
# WALLET_MARGIN_PERCENT=20

# LiteLLM gateway (docker compose --profile llm). The one-shot `litellm-setup`
# service provisions everything at start: it registers the gateway in
# auth-service and generates the secrets, which stay on a shared volume.
# Public URL of the gateway: also the access-token audience (RFC 8707 resource)
# and the url of the "litellm" application registered in auth-service.
# LITELLM_PUBLIC_URL=${PUBLIC_SCHEME}://llm.${DOMAIN}
# LITELLM_PORT=4000
# LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.105.0
# Optional: choose the keys instead of having them generated (`sk-` + 64 hex
# characters). Never change the salt key once models have been added.
# LITELLM_MASTER_KEY=
# LITELLM_SALT_KEY=
# Sign in to the LiteLLM admin interface through auth-service (default true).
# LITELLM_SSO_ENABLED=true
# Per-user ceilings enforced by the gateway hook: billable calls per minute,
# spend per minute (provider dollars) and model calls in progress at once.
# WALLET_MAX_REQUESTS_PER_MINUTE=120
# WALLET_MAX_SPEND_PER_MINUTE_USD=5
# WALLET_MAX_CONCURRENT_CALLS=8

# Optional Redis for shared rate-limit state across instances. Leave unset for
# the single-process in-memory store; set it and install `ioredis` to cluster.
REDIS_URL=

# Local mail catcher (docker compose --profile mail). Point SMTP_HOST at the
# mailpit service to inspect outbound mail at http://localhost:8025.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
