# Server
PORT=3001
HOST=0.0.0.0

# BetterAuth
BETTER_AUTH_SECRET=        # 32 random bytes: openssl rand -base64 32
BETTER_AUTH_URL=           # Public URL e.g. https://auth.example.com

# Database
POSTGRES_USER=auth
POSTGRES_PASSWORD=auth_secret
POSTGRES_DB=auth_service
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DATABASE_URL="postgres://auth:auth_secret@localhost:5433/auth_service"

# Bootstrap superadmin (auto-created at first startup if absent).
# ADMIN_PASSWORD must be at least 12 characters, and must not be this
# placeholder value (the bootstrap refuses known defaults).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123!

# CORS — allowed origins (comma-separated, static seed — also auto-populated from app URLs at runtime)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Number of trusted reverse-proxy hops. Default 0 (secure, no proxy). Set to 1
# when running behind a single reverse proxy so req.ip/rate-limits use the real
# client address instead of the proxy's.
TRUST_PROXY_HOPS=0

# OAuth protected resources (RFC 8707) are managed per application from the
# admin UI (oauth_resource table); there is no env seed for them.

# Email transport (SMTP)
# Required in production whenever any email flow is active
# (REQUIRE_EMAIL_VERIFICATION, MAGIC_LINK_ENABLED, EMAIL_OTP_ENABLED).
# - Port 465: implicit TLS
# - Port 587: STARTTLS upgrade (default)
# - Port 25:  unencrypted (avoid in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="auth-service <no-reply@example.com>"
# Optional Reply-To injected on every outbound email.
MAIL_REPLY_TO=

# Email flow toggles
# REQUIRE_EMAIL_VERIFICATION: when true, BetterAuth refuses to issue a session
# until the user clicks the verification link sent to their email. It is left
# `false` here so the Compose stack boots without SMTP; set it to `true` in
# production and configure SMTP_HOST below.
REQUIRE_EMAIL_VERIFICATION=false
# Opt-in passwordless flows. Both expose new endpoints — enable only after
# SMTP and rate-limits are in place.
MAGIC_LINK_ENABLED=false
EMAIL_OTP_ENABLED=false

# Stripe (optional — billing integration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=   # From Stripe Dashboard → Webhooks → signing secret

# OAuth social providers (optional — each requires CLIENT_ID + CLIENT_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Docker Compose image (docker-compose.yml). `nightly` tracks develop,
# `latest` is the latest tagged release. Override to pin a version.
AUTH_IMAGE=ghcr.io/circle-rd/auth-service:nightly

# Optional
# NODE_ENV is intentionally not set here: the Compose stack forces
# `production`, and local hot-reload (`pnpm dev`) sets `development` itself.
LOG_LEVEL=
SESSION_DOMAIN=

